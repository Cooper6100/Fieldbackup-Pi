[Unit]
Description=FieldBackup automatic SMB synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/fieldbackup-sync/sync.sh
TimeoutStartSec=infinity
TimeoutStopSec=30s
RuntimeDirectory=fieldbackup-sync
RuntimeDirectoryPreserve=yes
PrivateMounts=yes
Nice=10
IOSchedulingClass=idle
